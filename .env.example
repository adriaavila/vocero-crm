# ============================================================
# Vocero CRM — variables de entorno
# Copia este archivo a `.env` y reemplaza cada REEMPLAZA_...
# En producción estas variables van en tu plataforma de hosting
# (Coolify / docker compose), no solo en el archivo.
# ============================================================

# --- Aplicación ---------------------------------------------
# URL pública de la instancia (con https en producción).
# De ella se construye la URL del webhook de WhatsApp.
APP_BASE_URL=REEMPLAZA_https://crm.tudominio.com

# --- Allok SaaS multi-tenant (opcional) ---------------------
# Actívalo solo en el despliegue compartido de Allok. Cada negocio usa
# <slug>.allok.fun; los subdominios de producto (whatsapp, admin, crm,
# agent…) quedan reservados y nunca pueden ser un negocio.
# ALLOK_SAAS_MODE=true
# ALLOK_ROOT_DOMAIN=allok.fun
# ALLOK_SAAS_APP_URL=https://whatsapp.allok.fun
# ALLOK_LEGACY_HOST=https://crm.allok.fun
# ALLOK_LEGACY_ORGANIZATION_ID=organization_...
# Comas: emails autorizados para el panel interno admin.allok.fun.
# ALLOK_ADMIN_EMAILS=tu-correo@allok.fun
# ALLOK_SAAS_STRIPE_SECRET_KEY=REEMPLAZA_sk_test_o_rk_test
# ALLOK_SAAS_STRIPE_WEBHOOK_SECRET=REEMPLAZA_whsec_test
# ALLOK_SAAS_STRIPE_BASIC_PRICE_ID=price_...
# ALLOK_SAAS_STRIPE_PRO_PRICE_ID=price_...
# Agencia (inmobiliarias, USD 299/mes, sin prueba gratis).
# ALLOK_SAAS_STRIPE_INMO_PRICE_ID=price_...
# Qué planes vende este despliegue por checkout/facturación/registro,
# separados por coma (default basic,pro; no distingue mayúsculas). El panel
# admin puede conceder CUALQUIER plan del catálogo a mano sin importar esta
# variable — "inmobiliaria" (Agencia) se concede así hoy; súmalo aquí solo
# si además quieres venderlo por checkout.
# SAAS_PLANS=basic,pro,inmobiliaria
# Server-to-server link used by the SaaS WhatsApp Embedded Signup bridge.
# The same secret must be set in allok-fun as ALLOK_SAAS_LINK_SECRET.
# ALLOK_SAAS_LINK_URL=https://allok.fun/api/meta/tenant-onboarding-link
# ALLOK_SAAS_LINK_SECRET=REEMPLAZA_un_secreto_compartido_de_32_caracteres
# Destino que Allok debe recibir al finalizar Embedded Signup. En una
# instancia dedicada es, por ejemplo, `mistica` o `vocero-acme`; en SaaS es
# el destino del deployment multi-tenant.
# ALLOK_ONBOARDING_DESTINATION=vocero
# Número interno que puede recibir una prueba real después del handover.
# WHATSAPP_SMOKE_TEST_TO=+58412...

# --- Marca del despliegue (misma imagen, identidad distinta) -
# BRAND=allok (default, no hace falta declararlo) | rei. Decide el logo, los
# íconos, las fuentes, el acento por defecto y — en modo SaaS, en el host de
# alta — las páginas públicas (inicio, precios, legales) de src/app/(marketing).
# No confundir con ALLOK_BRAND=off, que apaga CUALQUIER marca (vuelve al
# Vocero de siempre) sin importar el valor de BRAND.
# BRAND=rei
#
# Rei necesita su propio host de alta: crm.reiprop.tech hace lo que
# whatsapp.allok.fun hace para allok (login, alta guiada por admin, puente de
# checkout). Sin esto cae al default app.<ALLOK_ROOT_DOMAIN>, que no es el
# host real de Rei.
# ALLOK_SAAS_APP_URL=https://crm.reiprop.tech
# Rei corre sin host heredado: "none" apaga ALLOK_LEGACY_HOST entero (si no,
# `crm.<dominio>` intentaría resolver una organización legacy que no existe).
# ALLOK_LEGACY_HOST=none
# Subdominios extra reservados para esta marca (coma), sumados a los de
# fábrica. Rei reserva los suyos de reiprop.tech; "demo" NO va acá: sigue
# siendo un slug de negocio válido.
# ALLOK_RESERVED_SUBDOMAINS=inmo,portal,smtp,dev,test
#
# Contacto público de la marca (BRAND=rei): CTAs de precios y de "quiero
# empezar" en las páginas públicas y en el login. allok trae el suyo de
# fábrica y no usa estas variables.
# CONTACT_WHATSAPP=59171234567
# CONTACT_EMAIL=hola@reiprop.tech
# Razón social y domicilio: obligatorios en /privacidad y /terminos. Sin
# ellos, esas páginas lo dicen en voz alta en vez de inventar un dato.
# LEGAL_NAME=REEMPLAZA_Razón social S.R.L.
# LEGAL_ADDRESS=REEMPLAZA_Dirección fiscal completa
# Demo pública enlazada desde /precios. Si no se define, cae al subdominio de
# producción de la marca activa.
# DEMO_URL=https://demo.reiprop.tech

# Solo Ruta B (docker compose): dominio para el HTTPS automático de Caddy.
DOMAIN=REEMPLAZA_crm.tudominio.com

# --- Base de datos ------------------------------------------
# Ruta B usa el servicio interno `postgres` del compose.
# Genera la contraseña con:  openssl rand -hex 24
POSTGRES_PASSWORD=REEMPLAZA_password_de_postgres
DATABASE_URL=postgresql://postgres:REEMPLAZA_password_de_postgres@postgres:5432/vocero

# --- Secretos de la aplicación ------------------------------
# Firma de sesiones. Genera con:  openssl rand -base64 32
BETTER_AUTH_SECRET=REEMPLAZA_secreto_de_sesiones

# Cifrado en reposo del token de WhatsApp (AES-256-GCM).
# DEBE ser exactamente 32 bytes en base64 (44 caracteres).
# Genera con:  openssl rand -base64 32
ENCRYPTION_KEY=REEMPLAZA_clave_de_cifrado_base64

# --- WhatsApp (webhook) -------------------------------------
# Token de verificación del webhook. Es también el segmento secreto
# de la URL del webhook: /api/webhooks/wa/<este_valor>
# Genera con:  openssl rand -hex 32
META_WEBHOOK_VERIFY_TOKEN=REEMPLAZA_token_de_verificacion

# OBLIGATORIO para recibir eventos reales: App Secret de la app de Meta
# que entrega el webhook (x-hub-signature-256).
# Se obtiene en developers.facebook.com → tu app → Configuración → Básica.
META_APP_SECRET=REEMPLAZA_app_secret_de_meta

# Versión de la Graph API (déjala así salvo que sepas por qué cambiarla).
META_GRAPH_API_VERSION=v25.0

# --- Embedded Signup de Meta EN la app (opcional) -----------
# Sin estas tres, "Conectar WhatsApp" usa el enlace guiado de allok.fun
# (comportamiento de siempre). Con ellas, el propio CRM hace el Embedded
# Signup: SDK, intercambio de código, override del webhook y alta del número.
# Nada aquí puede asumir un dominio fijo: la misma imagen sirve allok.fun y
# una segunda marca (p. ej. reiprop.tech) via ALLOK_SAAS_APP_URL/ALLOK_ROOT_DOMAIN.
#
# App ID de developers.facebook.com → tu app → Configuración → Básica.
# META_APP_ID=REEMPLAZA_app_id_de_meta
#
# Config de Meta Login for Business para COEXISTENCIA (el negocio ya usa la
# app de WhatsApp Business en su teléfono) — developers.facebook.com → tu app →
# WhatsApp → Embedded Signup → Configurations. Recomendada y default.
# META_ES_CONFIG_ID=REEMPLAZA_config_id_coexistencia
#
# Config para NÚMERO NUEVO (Cloud API puro, sin coexistencia). Opcional: sin
# ella la pantalla de alta solo ofrece coexistencia.
# META_ES_CONFIG_ID_CLOUD_API=REEMPLAZA_config_id_cloud_api

# --- Inteligencia artificial (opcional) ---------------------
# Sin ninguno de los dos, el CRM funciona completo excepto Agente y
# Laboratorio. Cada org elige su preferido en Configuración → Agente; el que
# NO esté elegido queda como respaldo automático si el preferido falla.
#
# Proveedor principal. Crea tu key en https://platform.openai.com → API keys
# (o usa cualquier proveedor compatible con la API de OpenAI cambiando
# OPENAI_BASE_URL).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# Modelo principal del agente (ej.: gpt-4o-mini)
# OPENAI_MODEL=
# Modelo del juez del Laboratorio (si se omite, usa OPENAI_MODEL)
# OPENAI_JUDGE_MODEL=
#
# Proveedor alterno (modelo gratuito). Crea tu key en https://openrouter.ai
# → Keys.
# OPENROUTER_API_TOKEN=
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# Modelo del agente. Si se omite, usa z-ai/glm-5.3-flash.
# OPENROUTER_MODEL=
# Modelo opcional del juez del Laboratorio; si se omite, usa OPENROUTER_MODEL.
# OPENROUTER_JUDGE_MODEL=

# --- Canales (opcional) -------------------------------------
# Canales encendidos, separados por coma. WhatsApp siempre esta activo.
# Sin esta variable la instancia es solo WhatsApp: las pantallas y webhooks
# de los demas canales responden 404 y no se piden sus credenciales.
# Para encender Instagram y/o Messenger (ver README - Canales opcionales):
# CHANNELS=whatsapp,instagram,messenger
#
# Instagram y Messenger pueden llegar por Zernio (API unificada). Las
# credenciales de cada cuenta se guardan cifradas desde la interfaz, no aqui;
# esta variable solo existe para apuntar a otra base de la API (pruebas).
# ZERNIO_BASE_URL=https://zernio.com/api/v1
#
# Self-test: para que `pnpm test:e2e` ejercite el canal de Messenger por
# Zernio hay que apuntarla a su mock (y lo mismo Zoom y Google para la agenda):
#   ZERNIO_BASE_URL=http://localhost:3000/api/dev/zernio-mock
#   ZOOM_BASE_URL=http://localhost:3000/api/dev/zoom-mock
#   ZOOM_OAUTH_BASE_URL=http://localhost:3000/api/dev/zoom-mock
#   GOOGLE_CAL_BASE_URL=http://localhost:3000/api/dev/google-mock
#   GOOGLE_OAUTH_BASE_URL=http://localhost:3000/api/dev/google-mock
# Sin ellas esos guiones fallan contra los proveedores de verdad.

# --- Atribucion de anuncios (opcional) -----------------------
# Conversions API de Meta: reporta el lead calificado y la venta cerrada de las
# conversaciones que llegaron por un anuncio Click-to-WhatsApp, para que tus
# campanas optimicen hacia quien compra. Apagada por defecto: sin esta variable
# no se guarda el identificador de clic (ctwa_clid), no se le reporta nada a
# Meta y toda su superficie responde 404.
#
# De que anuncio llego cada conversacion (titular, creativo, enlace) se ve en la
# bandeja SIEMPRE, con o sin esta variable (spec 018): llega en el mismo webhook
# y no pide nada. Lo unico que cambia sin ella es que no se guarda el clic.
# ATRIBUCION=on
#
# Encenderla NO pide credenciales nuevas: el dataset se pega en Ajustes -
# Anuncios y el token se reusa del de WhatsApp. Guia: docs/atribucion-capi.md

# --- Agenda (opcional) --------------------------------------
# Motor de agendamiento: horarios, citas y reservas del agente. Apagado por
# defecto. Sin esta variable no existe para nadie: ni pantalla de Citas, ni
# Ajustes de Agenda, ni rutas (responden 404), ni instrucciones de agendar en
# el prompt del agente.
# AGENDA=on
#
# Encenderla NO pide credenciales de terceros: el conector por defecto es
# "enlace-fijo" (pegas la URL de tu sala de siempre en Ajustes - Agenda).
# Para que cada cita genere su propia reunion, conecta Zoom o Google Calendar
# desde esa misma pantalla con las credenciales de TU cuenta (ver
# docs/agenda-conectores.md). Las variables de abajo solo se tocan para
# apuntar los conectores a los mocks del self-test:
# ZOOM_BASE_URL=https://api.zoom.us/v2
# ZOOM_OAUTH_BASE_URL=https://zoom.us
# GOOGLE_CAL_BASE_URL=https://www.googleapis.com/calendar/v3
# GOOGLE_OAUTH_BASE_URL=https://oauth2.googleapis.com

# --- Correo (opcional) --------------------------------------
# Conector de Resend para "¿Olvidaste tu contraseña?": con las dos variables encendido, sin ellas el login sigue con "Escríbenos".
# RESEND_API_KEY=   # resend.com -> API Keys (permiso "Sending access")
# EMAIL_FROM=allok <no-reply@allok.fun>   # remitente de un dominio verificado en Resend
# En local, con WA_MOCK_ENABLED=true, el correo puede caer en un sumidero en memoria en vez de Resend
# (se lee con GET en esa misma URL). Úsalo siempre que corras un servidor o un guion en modo SaaS.
# EMAIL_API_URL=http://localhost:3000/api/dev/email-sink

# --- Operación (opcional) -----------------------------------
# Reabrir el registro público después de la primera organización.
# ALLOW_SIGNUP=true

# Milisegundos de agrupación de mensajes antes del turno del agente (default 6000).
# AGENT_COALESCE_MS=6000

# SaaS: cuántos turnos puede procesar el worker de agent_job EN PARALELO
# (default 4). Antes de esto, el worker reclamaba y esperaba un trabajo a la
# vez — un solo turno lento (un despacho a Nea colgado) bloqueaba a TODOS los
# demás negocios. Subir este número no cambia cómo se reclaman los trabajos
# (siguen con FOR UPDATE SKIP LOCKED, uno por conversación), solo cuántos
# corren a la vez.
# AGENT_WORKER_CONCURRENCY=4

# --- Cerebro externo (opcional) -----------------------------
# Si en vez del agente in-process prefieres tu propio bot (un microservicio en
# el mismo servidor), habilita la API de servicio /api/bot/* con una API key:
# tu bot lee el contexto de la conversación y tu knowledge base, responde,
# guarda la ficha del lead y escala a un humano, además de marcar leído,
# mostrar "escribiendo…" y descargar adjuntos — todo SIN que el token de
# WhatsApp salga del CRM. Ver la tabla de endpoints en el README.
# Genera una larga y aleatoria (mínimo 16 caracteres); sin ella, /api/bot/*
# responde 401 y el CRM funciona igual con su agente propio.
#   openssl rand -base64 32
# BOT_API_KEY=

# URL del servicio de Nea (el cerebro externo por defecto): el CRM le
# DESPACHA cada turno entrante (POST ${NEA_DISPATCH_URL}, firmado con
# BOT_API_KEY) y espera su respuesta antes de continuar. BOT_API_KEY debe ser
# EL MISMO valor que CRM_BOT_API_KEY del lado de Nea — es la clave que firma
# el despacho. Sin NEA_DISPATCH_URL (o sin BOT_API_KEY), Rei (el agente
# in-process) contesta si tiene un proveedor de IA configurado.
#   NEA_DISPATCH_URL=http://nea-agent:8000/dispatch
# NEA_DISPATCH_URL=

# --- Provisión desde allok (capa de agencia) ----------------
# Secreto compartido con allok para `POST /api/provision`. allok conecta el
# número por Embedded Signup y empuja aquí sus credenciales antes de mover el
# webhook en Meta, así el alta no requiere copiar tokens a mano.
# El MISMO valor va en allok, en handover_destinations.provision_secret.
# Genera con:  openssl rand -base64 32
# PROVISION_API_KEY=

# --- Google Calendar (opcional) -----------------------------
# Camino recomendado: comparte un calendario existente con el client_email de
# una cuenta de servicio y pega su JSON completo codificado en base64.
# GOOGLE_CALENDAR_ID=tu-calendario@group.calendar.google.com
# GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# Fallback cuando el calendario compartido no permite crear Google Meet.
# Redirect URI: https://TU_DOMINIO/api/settings/calendar/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Horario local del negocio. El offset es local - UTC en minutos
# (Caracas: -240, Ciudad de México: -360; ajusta si hay horario de verano).
# ponytail: offset fijo; migrar a conversión IANA si se requieren cambios DST automáticos.
# CALENDAR_TIME_ZONE=UTC
# CALENDAR_UTC_OFFSET_MINUTES=0

# 008 - Directorio del volumen local de adjuntos (imagenes, docs, audios).
# En Coolify: montar un persistent storage en /data/media y poner esa ruta aqui.
# En dev local puede quedar el default relativo.
MEDIA_DIR=./.dev-media

# --- Vertical inmobiliario (opcional) ------------------------
# Con que vertical nace cada organizacion NUEVA de esta instancia (se guarda
# en organization.metadata.vertical al darse de alta: registro, alta admin
# POST /api/saas/businesses, o el seed demo). Sin esta variable (el caso de
# allok) ninguna organizacion nace con vertical y el CRM no cambia en nada.
# Unico valor soportado: inmobiliario (activa "Propiedades" en el nav y las
# rutas /api/properties/* SOLO para esas organizaciones; el resto del CRM
# sigue igual). Ver docs/vertical-inmobiliario.md si existe, o el server
# helper src/server/agencia/vertical.ts.
# DEFAULT_VERTICAL=inmobiliario

# Fotos de propiedades: bucket S3-compatible del OPERADOR del despliegue
# (Cloudflare R2). Sin las 5 variables, las fotos caen al camino sin
# dependencia externa: disco local bajo MEDIA_DIR, servido por una ruta
# autenticada (mismo comportamiento que los adjuntos de WhatsApp). Guia:
# R2_ACCOUNT_ID  -> Cloudflare dashboard, R2 -> Overview (a la derecha).
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY -> R2 -> Manage API tokens -> Create.
# R2_BUCKET -> el nombre del bucket (créalo antes en R2 -> Create bucket).
# R2_PUBLIC_BASE_URL -> R2 -> tu bucket -> Settings -> Public access (dominio
# propio o el *.r2.dev que Cloudflare ofrece), SIN barra al final.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=https://fotos.tudominio.com
